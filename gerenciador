/*
 * Sistema de Gerenciamento de Senhas de Atendimento Clínico
 *
 * Cadastra pacientes, classifica cada um em uma categoria (Urgente,
 * Preferencial ou Normal), emite senhas sequenciais independentes por
 * categoria (U001, P001, N001...) e controla a ordem de atendimento:
 *
 *     Urgente  >  Preferencial  >  Normal      (FIFO dentro de cada categoria)
 *
 * As regras de classificação são DIDÁTICAS (definidas para a atividade) e não
 * substituem a legislação de atendimento prioritário nem a avaliação clínica.
 *
 * Compilação: gcc -std=c11 -Wall -Wextra -pedantic -o gerenciador_senhas \
 *                 src/gerenciador_senhas.c
 */

#include <ctype.h>
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#ifdef _WIN32
#include <windows.h>
#endif

/* ------------------------------------------------------------------------ */
/* Constantes                                                               */
/* ------------------------------------------------------------------------ */

#define MAX_SENHAS_POR_CATEGORIA 999   /* N001..N999, P001..P999, U001..U999 */
#define TAM_LINHA                64    /* tamanho máximo de uma linha lida   */
#define TAM_CODIGO               8     /* "N001" + '\0' (com folga)          */
#define TAM_MOTIVOS              200
#define PROXIMAS_NO_PAINEL       5     /* quantas senhas futuras o painel mostra */

#define IDADE_MAXIMA             130
#define IDADE_URGENTE            80    /* urgente: idade SUPERIOR a 80       */
#define IDADE_PREF_MULHER        60    /* preferencial: mulher com 60 ou mais */
#define IDADE_PREF_HOMEM         65    /* preferencial: homem com 65 ou mais  */

/* Opções do menu principal */
#define OPC_SAIR                 0
#define OPC_REGISTRAR            1
#define OPC_CONSULTAR_PROXIMA    2
#define OPC_CHAMAR               3
#define OPC_IDENTIFICAR          4
#define OPC_FINALIZAR            5
#define OPC_PAINEL               6

/* ------------------------------------------------------------------------ */
/* Tipos de dados                                                           */
/* ------------------------------------------------------------------------ */

/* A ordem do enum é a ordem de prioridade de chamada (0 = maior). */
typedef enum {
    CAT_URGENTE = 0,
    CAT_PREFERENCIAL,
    CAT_NORMAL,
    TOTAL_CATEGORIAS
} Categoria;

static const char  PREFIXO_CATEGORIA[TOTAL_CATEGORIAS] = { 'U', 'P', 'N' };
static const char *NOME_CATEGORIA[TOTAL_CATEGORIAS] = {
    "Urgente", "Preferencial", "Normal"
};

typedef struct {
    char      codigo[TAM_CODIGO];  /* ex.: "P002"                          */
    Categoria categoria;
    char      genero;              /* 'F' ou 'M'                           */
    int       idade;
    int       gestante;            /* 1 = sim, 0 = não                     */
    int       lactante;
    int       necessidade_especial;
    int       obeso;
} Paciente;

/* Fila circular (FIFO) de capacidade fixa. */
typedef struct {
    Paciente itens[MAX_SENHAS_POR_CATEGORIA];
    int      inicio;
    int      tamanho;
} Fila;

/* Estado completo do sistema durante a execução. */
typedef struct {
    Fila     filas[TOTAL_CATEGORIAS];
    int      senhas_emitidas[TOTAL_CATEGORIAS];
    int      atendidos[TOTAL_CATEGORIAS];
    Paciente em_atendimento;
    int      ha_atendimento;       /* 1 = existe paciente em atendimento   */
} Sistema;

