/*
 * Gerenciador de Senhas de Atendimento Clínico
 *
 * Ordem de chamada: Urgente > Preferencial > Normal
 * Dentro de cada categoria: quem pegou a senha primeiro é chamado primeiro.
 *
 * Compilar: gcc -o senhas gerenciador_senhas.c
 */

#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

#define MAX_FILA 200

/* Categorias (a ordem é a ordem de prioridade) */
#define URGENTE      0
#define PREFERENCIAL 1
#define NORMAL       2

typedef struct {
    int categoria;
    int numero;
} Senha;

char prefixo[3]      = {'U', 'P', 'N'};
char *nomes[3]       = {"Urgente", "Preferencial", "Normal"};

Senha fila[MAX_FILA];          /* senhas aguardando, na ordem de emissão */
int totalFila = 0;
int ultimoNumero[3] = {0, 0, 0};   /* última senha emitida de cada categoria */

Senha atual;                   /* senha em atendimento */
int emAtendimento = 0;         /* 1 = há alguém em atendimento */

/* ---------- Leitura e validação ---------- */

void limparBuffer(void)
{
    int c;
    while ((c = getchar()) != '\n' && c != EOF) {
    }
}

int lerInteiro(char *mensagem, int min, int max)
{
    int valor, r;

    while (1) {
        printf("%s", mensagem);
        r = scanf("%d", &valor);
        if (r == EOF) {
            printf("\nEntrada encerrada.\n");
            exit(0);
        }
        limparBuffer();
        if (r != 1) {
            printf("Entrada inválida! Digite um número.\n");
        } else if (valor < min || valor > max) {
            printf("Valor inválido! Digite um número de %d a %d.\n", min, max);
        } else {
            return valor;
        }
    }
}

/* Retorna 1 para sim e 0 para não */
int lerSimNao(char *mensagem)
{
    char c;

    while (1) {
        printf("%s (S/N): ", mensagem);
        if (scanf(" %c", &c) == EOF) {
            printf("\nEntrada encerrada.\n");
            exit(0);
        }
        limparBuffer();
        c = toupper(c);
        if (c == 'S') {
            return 1;
        }
        if (c == 'N') {
            return 0;
        }
        printf("Resposta inválida! Digite S ou N.\n");
    }
}

char lerGenero(void)
{
    char c;

    while (1) {
        printf("Gênero (F ou M): ");
        if (scanf(" %c", &c) == EOF) {
            printf("\nEntrada encerrada.\n");
            exit(0);
        }
        limparBuffer();
        c = toupper(c);
        if (c == 'F' || c == 'M') {
            return c;
        }
        printf("Gênero inválido! Digite F ou M.\n");
    }
}

/* ---------- Cadastro e classificação ---------- */

int classificar(char genero, int idade, int gestante, int lactante,
                int especial, int obeso)
{
    if (idade > 80) {
        return URGENTE;
    }
    if (gestante || lactante || especial || obeso ||
        (genero == 'F' && idade >= 60) ||
        (genero == 'M' && idade >= 65)) {
        return PREFERENCIAL;
    }
    return NORMAL;
}

/* Gera a próxima senha da categoria e a coloca no fim da fila */
void gerarSenha(int categoria)
{
    ultimoNumero[categoria]++;
    fila[totalFila].categoria = categoria;
    fila[totalFila].numero = ultimoNumero[categoria];
    totalFila++;

    printf("\nSenha emitida: %c%03d (%s)\n",
           prefixo[categoria], ultimoNumero[categoria], nomes[categoria]);
}

void cadastrarPaciente(void)
{
    char genero;
    int idade, gestante = 0, lactante = 0, especial, obeso, categoria;

    if (totalFila >= MAX_FILA) {
        printf("A fila está cheia! Não é possível emitir nova senha.\n");
        return;
    }

    genero = lerGenero();
    idade = lerInteiro("Idade: ", 0, 120);
    if (genero == 'F') {
        gestante = lerSimNao("Está gestante?");
        lactante = lerSimNao("É lactante?");
    }
    especial = lerSimNao("Possui necessidade especial?");
    obeso = lerSimNao("Possui obesidade?");

    categoria = classificar(genero, idade, gestante, lactante, especial, obeso);

    gerarSenha(categoria);
}

/* ---------- Atendimento ---------- */

/* Retorna a posição da próxima senha a ser chamada, ou -1 se a fila estiver vazia */
int buscarProxima(void)
{
    int c, i;

    for (c = 0; c < 3; c++) {
        for (i = 0; i < totalFila; i++) {
            if (fila[i].categoria == c) {
                return i;
            }
        }
    }
    return -1;
}

void consultarProxima(void)
{
    int i = buscarProxima();

    if (i == -1) {
        printf("Não há senhas aguardando.\n");
    } else {
        printf("Próxima senha: %c%03d (%s)\n", prefixo[fila[i].categoria],
               fila[i].numero, nomes[fila[i].categoria]);
    }
}

/* Remove a senha da posição indicada (as seguintes andam uma posição) */
void removerDaFila(int posicao)
{
    int j;

    for (j = posicao; j < totalFila - 1; j++) {
        fila[j] = fila[j + 1];
    }
    totalFila--;
}

void chamarPaciente(void)
{
    int i;

    if (emAtendimento) {
        printf("A senha %c%03d ainda está em atendimento. Finalize-a primeiro.\n",
               prefixo[atual.categoria], atual.numero);
        return;
    }

    i = buscarProxima();
    if (i == -1) {
        printf("Não há senhas aguardando.\n");
        return;
    }

    atual = fila[i];
    emAtendimento = 1;
    removerDaFila(i);

    printf("Chamando a senha %c%03d (%s)!\n", prefixo[atual.categoria],
           atual.numero, nomes[atual.categoria]);
}

void mostrarEmAtendimento(void)
{
    if (emAtendimento) {
        printf("Em atendimento: %c%03d (%s)\n", prefixo[atual.categoria],
               atual.numero, nomes[atual.categoria]);
    } else {
        printf("Nenhuma senha em atendimento.\n");
    }
}

void finalizarAtendimento(void)
{
    if (!emAtendimento) {
        printf("Não há atendimento para finalizar.\n");
        return;
    }
    printf("Atendimento da senha %c%03d finalizado.\n",
           prefixo[atual.categoria], atual.numero);
    emAtendimento = 0;

    printf("Fila atualizada. ");
    consultarProxima();
}

/* ---------- Painel e menu ---------- */

int contarEspera(int categoria)
{
    int i, total = 0;

    for (i = 0; i < totalFila; i++) {
        if (fila[i].categoria == categoria) {
            total++;
        }
    }
    return total;
}

void mostrarPainel(void)
{
    int c, i, mostradas = 0;

    printf("\n===== PAINEL DE CHAMADA =====\n");
    if (emAtendimento) {
        printf("Senha chamada: %c%03d\n", prefixo[atual.categoria], atual.numero);
        printf("Categoria: %s\n", nomes[atual.categoria]);
    } else {
        printf("Senha chamada: nenhuma\n");
    }

    printf("Próximas senhas:");
    for (c = 0; c < 3; c++) {
        for (i = 0; i < totalFila; i++) {
            if (fila[i].categoria == c && mostradas < 5) {
                printf(" %c%03d", prefixo[c], fila[i].numero);
                mostradas++;
            }
        }
    }
    if (mostradas == 0) {
        printf(" nenhuma");
    }

    printf("\nEm espera - Urgente: %d | Preferencial: %d | Normal: %d\n",
           contarEspera(URGENTE), contarEspera(PREFERENCIAL), contarEspera(NORMAL));
    printf("=============================\n");
}

void mostrarMenu(void)
{
    printf("\n--- SENHAS DA CLÍNICA ---\n");
    printf("1 - Cadastrar paciente\n");
    printf("2 - Consultar próxima senha\n");
    printf("3 - Chamar paciente\n");
    printf("4 - Ver senha em atendimento\n");
    printf("5 - Finalizar atendimento\n");
    printf("6 - Painel de chamada\n");
    printf("0 - Sair\n");
}

int main(void)
{
    int opcao;

    do {
        mostrarMenu();
        opcao = lerInteiro("Opção: ", 0, 6);

        switch (opcao) {
        case 1: cadastrarPaciente();     break;
        case 2: consultarProxima();      break;
        case 3: chamarPaciente();        break;
        case 4: mostrarEmAtendimento();  break;
        case 5: finalizarAtendimento();  break;
        case 6: mostrarPainel();         break;
        case 0: printf("Encerrando o sistema.\n"); break;
        }
    } while (opcao != 0);

    return 0;
}
